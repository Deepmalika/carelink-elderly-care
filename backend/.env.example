# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# Use the "Session pooler" or direct connection string, e.g.:
# postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate a real random secret before deploying — do not reuse this one.
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000

# URL of the deployed FastAPI ML service.
ML_SERVICE_URL="http://localhost:8001"

# Your deployed frontend's URL, so CORS only trusts it (rather than allowing
# every origin). Leave unset in local dev.
# FRONTEND_URL="https://your-app.vercel.app"
